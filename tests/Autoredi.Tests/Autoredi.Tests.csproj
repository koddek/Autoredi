<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- Enable source generators -->
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Imposter" Version="*" />
        <PackageReference Include="TUnit" Version="1.65.63" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" PrivateAssets="all" />
        <!-- Runtime dependency of Autoredi.Generators; needed when driving the generator directly. -->
        <PackageReference Include="Flowgen" Version="0.7.0" />
        <PackageReference Update="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
        <PackageReference Update="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
        <PackageReference Update="Microsoft.SourceLink.GitHub" Version="10.0.400" />
    </ItemGroup>

    <!-- Reference the main project -->
    <ItemGroup>
        <ProjectReference Include="..\..\src\Autoredi\Autoredi.csproj" />
        <ProjectReference Include="..\..\samples\Samples.Modular.Infrastructure\Samples.Modular.Infrastructure.csproj" />
    </ItemGroup>

    <!-- Reference the source generator project -->
    <ItemGroup>
        <ProjectReference Include="..\..\src\Autoredi.Generators\Autoredi.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
        <!-- Direct reference for generator-driver tests (CSharpGeneratorDriver). -->
        <Reference Include="Autoredi.Generators">
            <HintPath>..\..\src\Autoredi.Generators\bin\$(Configuration)\netstandard2.0\Autoredi.Generators.dll</HintPath>
        </Reference>
    </ItemGroup>

</Project>
