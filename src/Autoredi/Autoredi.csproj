<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- The package ships one attribute plus a Roslyn analyzer, so it has no reason to lock
             consumers to a single modern TFM. netstandard2.0 lets net8.0/net9.0 and older class
             libraries reference Autoredi; net10.0 keeps .NET 10 (LTS) on its own asset; net11.0 is
             the current LTS-band entry point. The analyzer itself stays netstandard2.0. -->
        <TargetFrameworks>netstandard2.0;net10.0;net11.0</TargetFrameworks>
        <LangVersion>15</LangVersion>
        <PackageId>Autoredi</PackageId>
        <Version>0.7.0</Version>
        <IsPackable>true</IsPackable>
        <!-- No GeneratePackageOnBuild: pack is an explicit, verified step (CI and
             scripts/verify-package-smoke.mjs both call dotnet pack). Building the solution must
             not require the strong-name key, and must not silently produce a package. -->
    </PropertyGroup>

    <ItemGroup>
        <!-- Building the library builds the analyzer too, so pack never picks up a stale generator DLL. -->
        <ProjectReference Include="..\Autoredi.Generators\Autoredi.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
        <!-- Analyzer payload is TFM-independent, so it ships once at the package root of analyzers.
             The analyzer is self-contained: no third-party assemblies travel with it. -->
        <None Include="$(MSBuildProjectDirectory)\..\Autoredi.Generators\bin\$(Configuration)\netstandard2.0\Autoredi.Generators.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false"/>
        <!-- Agent skill travels with the package so coding agents can discover usage guidance
             at ~/.nuget/packages/autoredi/<version>/skills/Autoredi/SKILL.md -->
        <None Include="..\..\docs\skills\autoredi\SKILL.md" Pack="true" PackagePath="skills/Autoredi" Visible="false" />
    </ItemGroup>

    <ItemGroup>
      <!-- The library only needs MEDI abstractions; the implementation package must not leak
           into Autoredi's own dependency graph. -->
      <PackageReference Remove="Microsoft.Extensions.DependencyInjection" />
    </ItemGroup>

    <!-- Directory.Build.props only enables signing when the key file is present, so a
         contributor without the secret can still build. Publishing must never be unsigned. -->
    <Target Name="RequireStrongNameKeyForPack" BeforeTargets="GenerateNuspec" Condition="'$(SignAssembly)' != 'true'">
        <Error Code="AUTOREDI001" Text="Autoredi.snk was not found next to Directory.Build.props, so this package would ship unsigned. Restore the key or set SignAssembly=false deliberately before packing." />
    </Target>

</Project>
