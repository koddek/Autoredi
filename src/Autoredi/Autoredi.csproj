<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <PackageId>Autoredi</PackageId>
        <Version>0.5.1</Version>
        <IsPackable>true</IsPackable>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Autoredi.Generators\Autoredi.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
        <None Include="$(MSBuildProjectDirectory)\..\Autoredi.Generators\bin\$(Configuration)\netstandard2.0\Autoredi.Generators.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false"/>
        <None Include="$(PkgFlowgen)\lib\netstandard2.0\Flowgen.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false"/>
    </ItemGroup>

    <ItemGroup>
        <!-- Agent skill travels with the package so coding agents can discover usage guidance
             at ~/.nuget/packages/autoredi/<version>/skills/Autoredi/SKILL.md -->
        <None Include="..\..\docs\skills\autoredi\SKILL.md" Pack="true" PackagePath="skills/Autoredi" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Flowgen" Version="0.7.0" GeneratePathProperty="true" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Remove="Microsoft.Extensions.DependencyInjection" />
      <PackageReference Update="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
      <PackageReference Update="Microsoft.SourceLink.GitHub" Version="10.0.400" />
    </ItemGroup>

</Project>
