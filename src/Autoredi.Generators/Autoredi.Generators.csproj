<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>15</LangVersion>
        <IsPackable>false</IsPackable>
        <IsRoslynComponent>true</IsRoslynComponent>
        <RootNamespace>Autoredi.Generators</RootNamespace>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <!-- Shipped as an analyzer, never referenced as a library: no public API to document
             and no release-tracking file to maintain, so RS2008 stays off. -->
        <NoWarn>$(NoWarn);CS1591;CS8002;RS2008</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" PrivateAssets="all" />
        <!-- The analyzer is self-contained: it must not pull MEDI in, only Roslyn. -->
        <PackageReference Remove="Microsoft.Extensions.DependencyInjection" />
        <PackageReference Remove="Microsoft.Extensions.DependencyInjection.Abstractions" />
    </ItemGroup>

</Project>
